# ==============================================================================
# Transformer-Based WAF Environment Variables Template
# Copy to .env for local customized configuration
# ==============================================================================

# Database Secrets
POSTGRES_USER=waf_admin
POSTGRES_PASSWORD=waf_secret_pass_2026
POSTGRES_DB=transformer_waf

# Redis Queue Configuration
REDIS_URL=redis://localhost:6379

# NestJS Auth & JWT Secrets (at least 32 characters)
JWT_ACCESS_SECRET=dev_jwt_access_secret_super_secure_32chars!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_super_secure_32chars!

# Internal Ingestion & WAF Administration Secrets
WAF_INGEST_KEY=waf-internal-ingest-secret-dev
WAF_ADMIN_KEY=waf-admin-secret-key-local
WAF_CHALLENGE_SECRET=dev_challenge_secret_super_secure_32chars!

# Control Plane & Gateway Addresses
CORS_ORIGIN=http://localhost:5173
WAF_CONTROL_PLANE_URL=http://localhost:3000
WAF_GATEWAY_ADMIN_URL=http://localhost:8001
