// Prisma Schema for Transformer-WAF SaaS (Phase 8 Multi-tenant Shared-Schema)
// Datasource and generator configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// Core Multi-Tenant & Identity Models
// ----------------------------------------------------

enum TenantTier {
  FREE
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

enum SiteStatus {
  ACTIVE
  PAUSED
  MAINTENANCE
}

enum WafMode {
  MONITOR
  BLOCKING
  STRICT
  CORROBORATED
  DISABLED
}

enum MlFailureMode {
  FAIL_OPEN
  FAIL_CLOSED
}

enum WafAction {
  ALLOW
  MONITOR
  CHALLENGE
  BLOCK
}

enum FeedbackLabel {
  FALSE_POSITIVE
  CONFIRMED_ATTACK
  SUSPICIOUS
  NEEDS_INVESTIGATION
}

enum FeedbackReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(100)
  slug        String       @unique @db.VarChar(50)
  tier        TenantTier   @default(FREE)
  status      TenantStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relationships
  memberships     Membership[]
  protectedSites  ProtectedSite[]
  wafPolicies     WafPolicy[]
  securityEvents  SecurityEvent[]
  eventFeedbacks  EventFeedback[]
  auditLogs       AuditLog[]
  refreshSessions RefreshSession[]
  notifications   Notification[]
  webhookEndpoints WebhookEndpoint[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(255)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  name         String?      @db.VarChar(100)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relationships
  memberships        Membership[]
  auditLogs          AuditLog[]
  refreshSessions    RefreshSession[]
  submittedFeedbacks EventFeedback[]  @relation("FeedbackSubmittedBy")
  reviewedFeedbacks  EventFeedback[]  @relation("FeedbackReviewedBy")

  @@index([email])
  @@map("users")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      UserRole @default(VIEWER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_sessions")
}

// ----------------------------------------------------
// Protected Sites & WAF Configuration
// ----------------------------------------------------

model ProtectedSite {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  name        String     @db.VarChar(100)
  domain      String     @db.VarChar(255)
  upstreamUrl String     @map("upstream_url") @db.VarChar(500)
  status      SiteStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wafPolicies    WafPolicy[]
  securityEvents SecurityEvent[]
  eventFeedbacks EventFeedback[]
  notifications  Notification[]

  @@unique([tenantId, domain])
  @@index([tenantId])
  @@index([domain])
  @@map("protected_sites")
}

model WafPolicy {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  siteId               String?       @map("site_id") @db.Uuid
  name                 String        @default("Default Policy") @db.VarChar(100)
  mode                 WafMode       @default(MONITOR)
  mlEnabled            Boolean       @default(true) @map("ml_enabled")
  rulesEnabled         Boolean       @default(true) @map("rules_enabled")
  challengeEnabled     Boolean       @default(true) @map("challenge_enabled")
  monitorThreshold     Float         @default(0.05) @map("monitor_threshold")
  challengeThreshold   Float         @default(0.50) @map("challenge_threshold")
  blockThreshold       Float         @default(0.85) @map("block_threshold")
  mlFailureMode        MlFailureMode @default(FAIL_OPEN) @map("ml_failure_mode")
  exclusionsJson       Json          @default("[]") @map("exclusions_json")
  modelVersion         String        @default("v1_0") @map("model_version") @db.VarChar(50)
  version              Int           @default(1)
  isActive             Boolean       @default(true) @map("is_active")
  updatedByUserId      String?       @map("updated_by_user_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site   ProtectedSite? @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([siteId])
  @@index([tenantId, siteId, version])
  @@map("waf_policies")
}

// ----------------------------------------------------
// Security Events & Audit Logging
// ----------------------------------------------------

model SecurityEvent {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  siteId              String?          @map("site_id") @db.Uuid
  requestId           String           @map("request_id") @db.VarChar(64)
  clientIpHash        String?          @map("client_ip_hash") @db.VarChar(64)
  method              String           @db.VarChar(10)
  path                String           @db.VarChar(2048)
  action              WafAction
  wouldAction         WafAction?       @map("would_action")
  reason              String?          @db.VarChar(255)
  riskScore           Float            @default(0.0) @map("risk_score")
  severity            SecuritySeverity @default(LOW)
  stageUsed           String?          @map("stage_used") @db.VarChar(50)
  ruleMatchesJson     Json?            @default("[]") @map("rule_matches_json")
  anomalyFlagsJson    Json?            @default("[]") @map("anomaly_flags_json")
  degradedMode        Boolean          @default(false) @map("degraded_mode")
  modelVersion        String?          @default("v1_0") @map("model_version") @db.VarChar(50)
  policyVersion       Int?             @default(1) @map("policy_version")
  latencyMs           Float            @default(0.0) @map("latency_ms")
  redactedRequestJson Json?            @map("redacted_request_json")
  createdAt           DateTime         @default(now()) @map("created_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site           ProtectedSite?  @relation(fields: [siteId], references: [id], onDelete: SetNull)
  eventFeedbacks EventFeedback[]

  @@index([tenantId, createdAt])
  @@index([tenantId, siteId, createdAt])
  @@index([action])
  @@map("security_events")
}

model EventFeedback {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  siteId            String?              @map("site_id") @db.Uuid
  securityEventId   String               @map("security_event_id") @db.Uuid
  submittedByUserId String?              @map("submitted_by_user_id") @db.Uuid
  label             FeedbackLabel
  reviewStatus      FeedbackReviewStatus @default(PENDING_REVIEW) @map("review_status")
  reviewerUserId    String?              @map("reviewer_user_id") @db.Uuid
  notes             String?              @db.Text
  reviewNotes       String?              @map("review_notes") @db.Text
  createdAt         DateTime             @default(now()) @map("created_at")
  reviewedAt        DateTime?            @map("reviewed_at")

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site            ProtectedSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  securityEvent   SecurityEvent @relation(fields: [securityEventId], references: [id], onDelete: Cascade)
  submittedByUser User?         @relation("FeedbackSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewerUser    User?         @relation("FeedbackReviewedBy", fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, reviewStatus])
  @@index([tenantId, securityEventId])
  @@map("event_feedbacks")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @map("resource_id") @db.VarChar(100)
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ----------------------------------------------------
// Notifications & Webhook Alerting (Phase 13)
// ----------------------------------------------------

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum NotificationType {
  ATTACK_SPIKE
  ML_DEGRADED
  POLICY_SYNC_FAILED
  FEEDBACK_EXPORT_READY
}

model Notification {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  siteId       String?              @map("site_id") @db.Uuid
  severity     NotificationSeverity @default(INFO)
  type         NotificationType
  title        String               @db.VarChar(255)
  message      String               @db.Text
  metadataJson Json?                @map("metadata_json")
  isRead       Boolean              @default(false) @map("is_read")
  readAt       DateTime?            @map("read_at")
  createdAt    DateTime             @default(now()) @map("created_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site   ProtectedSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([tenantId, isRead, createdAt])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

model WebhookEndpoint {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String   @db.VarChar(100)
  url        String   @db.VarChar(2048)
  secretHash String   @map("secret_hash") @db.VarChar(255)
  eventsJson Json     @default("[]") @map("events_json")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("webhook_endpoints")
}

